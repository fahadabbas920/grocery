# Root env reference for the whole monorepo. Copy the relevant vars into each
# app's own .env(.local) — Next apps read .env.local, the Expo app reads .env.
# DO NOT COMMIT real secrets. Only this .example file is tracked.

# ---- Supabase (from your project's API settings) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key   # SERVER ONLY — never expose

# Expo variants for the rider app (same values, EXPO_PUBLIC_ prefix):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key

# ---- Google Maps Platform ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-google-maps-browser-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-google-maps-key
