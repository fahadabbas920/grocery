{
  // This is a JS/TS (pnpm + Turborepo) monorepo — no JVM/Gradle build runs in
  // the editor. The "Plugin with id 'com.android.library' not found" popups come
  // from the Java/Gradle extensions scanning node_modules, where Expo/React Native
  // libraries ship android/build.gradle files that reference the Android Gradle
  // Plugin. These settings stop that scanning. (Native Android builds for the
  // rider app happen on EAS, not locally.)
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.expo/**",
    "**/android/**",
    "**/ios/**"
  ],
  "gradle.nestedProjects": false,

  // Keep the file watcher off generated/dependency dirs (perf + fewer false scans).
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/.expo/**": true,
    "**/dist/**": true
  }
}
