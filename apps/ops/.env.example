# Ops Console (Next.js) — copy to .env.local and fill in. DO NOT COMMIT real values.

# Public Supabase config (safe to expose to the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key

# Server-only. Bypasses RLS — used by Server Actions for privileged ops
# (e.g. creating rider accounts). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key

# Map provider config (provider, public rendering token) is NOT an env var —
# it's shared with the shop app via the `app_settings` table (set from
# Ops → Settings), read at request time via `getMapsConfig()`. Nothing to
# set here for the planned live rider map (see CLAUDE.md TODO).
