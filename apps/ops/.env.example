# Ops Console (Next.js) — copy to .env.local and fill in. DO NOT COMMIT real values.

# Public Supabase config (safe to expose to the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key

# Server-only. Bypasses RLS — used by Server Actions for privileged ops
# (e.g. creating rider accounts). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key

# Google Maps JS API key for the live rider map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-google-maps-browser-key
