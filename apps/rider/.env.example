# Rider App (Expo) — copy to .env and fill in. DO NOT COMMIT real values.
# Expo inlines EXPO_PUBLIC_* vars into the app bundle at build time.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key

# Used for in-app Google Maps navigation deep links (optional for MVP — the app
# falls back to the public maps URL scheme without it).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-google-maps-key
