# Customer PWA (Next.js) — copy to .env.local and fill in. DO NOT COMMIT real values.

# Public Supabase config (safe to expose; RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key

# Google Maps Embed/JS key for live rider tracking on the map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-google-maps-browser-key
