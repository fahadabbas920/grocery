# Customer PWA (Next.js) — copy to .env.local and fill in. DO NOT COMMIT real values.

# Public Supabase config (safe to expose; RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key

# Map provider config (provider, public rendering token) is NOT an env var —
# it lives in the `app_settings` table, set from the Ops → Settings page, and
# read at request time via `getMapsConfig()`. There is nothing to set here.
# The provider's SECRET key (used for geocoding by the `maps-proxy` Edge
# Function) is a Supabase function secret — see supabase/functions/maps-proxy.
