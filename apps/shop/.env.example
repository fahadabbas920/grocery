# Customer PWA (Next.js) — copy to .env.local and fill in. DO NOT COMMIT real values.

# Public Supabase config (safe to expose; RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-key

# Map provider — set ONE (or both; Mapbox takes priority when both are present).
# Mapbox (free tier, no credit card): https://mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR-mapbox-public-token

# Google Maps (fallback): https://console.cloud.google.com
# Required APIs: Maps JavaScript API, Maps Embed API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-google-maps-browser-key
